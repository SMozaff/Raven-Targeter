# Copy this file to .env and fill in real values. Never commit .env.

# GitHub personal access token (recommended). App still runs without it,
# but unauthenticated GitHub API rate limits are very low (60 req/hr).
GITHUB_TOKEN=

# Comma-separated target providers to search for by default.
RAVEN_TARGETS=openai,anthropic,gemini,grok,deepseek

# How many days back to search, by default.
RAVEN_LOOKBACK_DAYS=10

# Max results accepted per source, by default.
RAVEN_MAX_RESULTS_PER_SOURCE=200

# SQLAlchemy database URL.
RAVEN_DB_URL=sqlite:///data/raven.db

# Logging level: DEBUG, INFO, WARNING, ERROR.
RAVEN_LOG_LEVEL=INFO
