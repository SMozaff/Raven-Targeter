# Desktop users should enter API credentials in Settings / APIs.
# The app stores them in the operating-system keychain.
# These secret environment variables are advanced/headless/CI overrides only:
GITHUB_TOKEN=
SEARCH_API_KEY=

RAVEN_TARGETS=openai,anthropic,gemini,grok,deepseek
RAVEN_LOOKBACK_DAYS=10
RAVEN_MAX_RESULTS_PER_SOURCE=200
RAVEN_DB_URL=sqlite:///data/raven.db
RAVEN_LOG_LEVEL=INFO

# Optional web-search layer. Desktop values are normally chosen in the GUI.
RAVEN_SEARCH_API_PROVIDER=disabled
RAVEN_SEARCH_API_ENGINE=google
RAVEN_SEARCH_API_BASE_URL=https://serpapi.com/search.json
RAVEN_SEARCH_API_MAX_QUERIES=10
